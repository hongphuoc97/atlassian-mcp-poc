# MCP Server — Atlassian (Jira + Confluence)

# Jira Cloud base URL — e.g. https://your-org.atlassian.net
JIRA_BASE_URL=https://your-org.atlassian.net

# Confluence Cloud base URL — usually same host as Jira
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# Atlassian API token (read-only scope)
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=your-poc-account@example.com
ATLASSIAN_API_TOKEN=REPLACE_WITH_YOUR_TOKEN

# Allowlisted Jira project keys (comma-separated)
JIRA_ALLOWED_PROJECTS=POC

# Allowlisted Confluence space keys (comma-separated)
CONFLUENCE_ALLOWED_SPACES=AICR

# MCP server transport: stdio (for local/Copilot) or http
MCP_TRANSPORT=stdio

# Optional HTTP port when MCP_TRANSPORT=http
MCP_HTTP_PORT=3000

# Cache TTL in seconds
CACHE_TTL_SECONDS=120

# Timeout per Atlassian API call in ms
REQUEST_TIMEOUT_MS=8000

# Max content length returned per page (characters)
MAX_PAGE_CONTENT_CHARS=4000
